<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="32dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/trustIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_tile_blue"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_shield"
            app:tint="@color/accent_fg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/trustTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fg"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/trustHost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/trustBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:lineSpacingMultiplier="1.15"
        android:textColor="@color/soft"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/trustOld"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/trustFpLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:letterSpacing="0.04"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <GridLayout
        android:id="@+id/trustGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_fp_box"
        android:columnCount="4"
        android:padding="10dp"
        android:useDefaultMargins="false" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/trustAccept"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="22dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/trustCancel"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/cancel"
        android:textColor="@color/fg"
        android:textSize="16sp"
        app:cornerRadius="14dp"
        app:strokeColor="#2E343D" />
</LinearLayout>
